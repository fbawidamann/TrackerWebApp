# Copy to .env on the VPS and adjust to the existing Traefik setup.
APP_DOMAIN=tracker.fbawidamannserver.cloud
# Docker network Traefik is attached to (docker network ls / docker inspect <traefik container>)
TRAEFIK_NETWORK=traefik
# Traefik entrypoint that serves HTTPS (often "websecure" or "https")
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
