# Copy to .env on the VPS. Values match the VPS setup (Traefik in host network mode).
APP_DOMAIN=tracker.fbawidamannserver.cloud
# Loopback port the container is published on; Traefik forwards here. Must be free on the host.
APP_HOST_PORT=63255
# Traefik entrypoints (house standard on this VPS)
TRAEFIK_ENTRYPOINTS=web,websecure
TRAEFIK_CERTRESOLVER=letsencrypt
