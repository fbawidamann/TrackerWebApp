# Copy to .env on the VPS. Values match the VPS setup (Traefik in host network mode).
APP_DOMAIN=tracker.fbawidamannserver.cloud
# Loopback port the container is published on; Traefik forwards here. Must be free on the host.
APP_HOST_PORT=63255
# Traefik entrypoints (house standard on this VPS)
TRAEFIK_ENTRYPOINTS=web,websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Database password (only used between the app and db containers). Generate once, hex so it's URL-safe:
#   openssl rand -hex 32
DB_PASSWORD=

# Strava (optional, docs/adr/0009-strava.md). From https://www.strava.com/settings/api
# ("Authorization Callback Domain" = APP_DOMAIN). Leave empty to switch Strava off.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Encrypts the Strava tokens in the database. Generate once: openssl rand -hex 32  (changing it disconnects everyone)
STRAVA_TOKEN_KEY=
